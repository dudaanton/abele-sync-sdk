{
  "name": "@abele/sync-sdk",
  "version": "0.3.0",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dudaanton/abele-sync-sdk.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/dudaanton/abele-sync-sdk/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/dudaanton/abele-sync-sdk/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./notes": {
      "types": "./dist/notes/index.d.ts",
      "import": "./dist/notes/index.js"
    },
    "./core": {
      "types": "./dist/internal/core/index.d.ts",
      "import": "./dist/internal/core/index.js"
    },
    "./protocol": {
      "types": "./dist/internal/protocol/index.d.ts",
      "import": "./dist/internal/protocol/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b ../notes . && node ../../scripts/bundle-internal.mjs"
  },
  "dependencies": {
    "zod": "3.25.76",
    "yaml": "2.9.0",
    "@noble/hashes": "1.8.0",
    "better-sqlite3": "11.10.0",
    "dayjs": "1.11.18",
    "js-yaml": "4.3.2",
    "@types/js-yaml": "4.0.9"
  },
  "description": "Node client SDK to sync a folder or your own storage with an Abele sync server by connection key, including a task and note parser.",
  "keywords": [
    "abele",
    "sync",
    "sdk",
    "notes",
    "tasks"
  ]
}
